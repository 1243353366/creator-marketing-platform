{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "creator-marketing-platform",
  "main": "src/worker.js",
  "compatibility_date": "2024-09-23",
  "workers_dev": true,
  "ai": { "binding": "AI" },
  "d1_databases": [
    { "binding": "DB", "database_name": "creator-marketing-platform" }
  ]
}
