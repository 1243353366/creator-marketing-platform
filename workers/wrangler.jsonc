{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "creator-marketing-platform",
  "main": "src/worker.js",
  "compatibility_date": "2024-09-23",
  "workers_dev": true,
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [{ "name": "STORE", "class_name": "Store" }]
  },
  "exports": {
    "Store": { "type": "durable-object", "storage": "sqlite" }
  }
}
